# رقم واتساب استقبال طلبات الفنيين (صيغة دولية بدون +)، مثال: 9665XXXXXXXX
PUBLIC_WHATSAPP_NUMBER=
# Google Tag Manager container ID، مثال: GTM-XXXXXXX
PUBLIC_GTM_ID=
# رمز التحقق من Google Search Console (قيمة content فقط)
PUBLIC_GSC_VERIFICATION=
# AdSense publisher ID، مثال: ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_CLIENT=
# اتركه false حتى يتجاوز الموقع ~10,000 زيارة شهريًا
PUBLIC_ADSENSE_ENABLED=false
# رقم الـ slot لإعلان نهاية المقال (يعمل فقط عند تفعيل أدسنس)
PUBLIC_ADSENSE_SLOT_ARTICLE=
