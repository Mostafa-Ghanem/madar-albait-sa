---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import BaseLayout from "@/layouts/Base.astro";
const tags = getUniqueTagsWithCount(await getAllPosts());
---
<BaseLayout meta={{title:"الوسوم",description:"وسوم تنظيمية داخل مكتبة مدار البيت.",noindex:true}}>
  <header class="page-hero"><h1>الوسوم</h1><p>روابط تنظيمية للوصول إلى الموضوعات المتقاربة.</p></header>
  <ul class="tag-cloud">{tags.map(([tag,count]) => <li><a href={`/tags/${tag}/`}>#{tag} <span>{count}</span></a></li>)}</ul>
</BaseLayout>
