---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags } from "@/data/post";
import BaseLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
export const getStaticPaths = (async ({ paginate }) => {
  const posts=(await getAllPosts()).sort(collectionDateSort);
  return getUniqueTags(posts).flatMap(tag => paginate(posts.filter(p=>p.data.tags.includes(tag)),{pageSize:12,params:{tag}}));
}) satisfies GetStaticPaths;
type Props=InferGetStaticPropsType<typeof getStaticPaths>;
const { page }=Astro.props as Props; const { tag }=Astro.params;
const pageSuffix=page.currentPage > 1 ? ` — الصفحة ${page.currentPage}` : "";
const paginationProps={...(page.url.prev&&{prevUrl:{text:"→ الصفحة السابقة",url:page.url.prev}}),...(page.url.next&&{nextUrl:{text:"الصفحة التالية ←",url:page.url.next}})};
---
<BaseLayout meta={{title:`موضوعات ${tag}${pageSuffix}`,description:`أدلة مرتبطة بوسم ${tag} في مدار البيت${page.currentPage > 1 ? ` — صفحة ${page.currentPage}` : ""}.`,noindex:true}}>
  <header class="page-hero"><span class="eyebrow">وسم تنظيمي</span><h1>#{tag}{page.currentPage > 1 && ` — الصفحة ${page.currentPage}`}</h1><p>المقالات المرتبطة بهذا الموضوع.</p></header>
  <div class="post-grid">{page.data.map(p => <PostPreview post={p} />)}</div><Pagination {...paginationProps}/>
</BaseLayout>
