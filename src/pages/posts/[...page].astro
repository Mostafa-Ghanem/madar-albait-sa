---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts } from "@/data/post";
import BaseLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
export const getStaticPaths = (async ({ paginate }) => paginate((await getAllPosts()).sort(collectionDateSort), { pageSize: 12 })) satisfies GetStaticPaths;
interface Props { page: Page<CollectionEntry<"post">> }
const { page } = Astro.props;
const paginationProps = { ...(page.url.prev && { prevUrl:{ text:"→ الصفحة السابقة", url:page.url.prev } }), ...(page.url.next && { nextUrl:{ text:"الصفحة التالية ←", url:page.url.next } }) };
---
<BaseLayout meta={{ title:"كل الأدلة", description:"جميع أدلة مدار البيت للأقمار والقنوات وأجهزة الاستقبال والمشاهدة الذكية داخل السعودية." }}>
  <header class="page-hero"><span class="eyebrow">مكتبة المحتوى</span><h1>كل الأدلة</h1><p>محتوى منظم حسب النية والمشكلة، مع توضيح تاريخ التحديث والتحقق.</p></header>
  <div class="post-grid">{page.data.map(p => <PostPreview post={p} />)}</div><Pagination {...paginationProps} />
</BaseLayout>
