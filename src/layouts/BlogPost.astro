---
import { type CollectionEntry, render } from "astro:content";
import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import BaseLayout from "./Base.astro";
import { getAuthor } from "@/data/authors";
import { siteConfig, categoryMeta } from "@/site.config";
interface Props { post: CollectionEntry<"post"> }
const { post } = Astro.props;
const { data } = post;
const { headings } = await render(post);
const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingTime = `${Math.max(1, Math.ceil(wordCount / 180))} دقائق قراءة`;
const author = getAuthor(data.authorSlug);
const articleDate = (data.updatedDate ?? data.publishDate).toISOString();
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  inLanguage: "ar-SA",
  mainEntityOfPage: new URL(`/posts/${post.id}/`, siteConfig.url).href,
  author: { "@type": "Person", name: author.name, url: new URL(`/authors/${data.authorSlug}/`, siteConfig.url).href },
  publisher: { "@type": "Organization", name: siteConfig.title, url: siteConfig.url },
  articleSection: categoryMeta[data.category]?.title,
};
---
<BaseLayout meta={{ title: data.title, description: data.description, articleDate, ogImage: data.ogImage }}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="article-shell" data-pagefind-body>
    <Masthead content={post} readingTime={readingTime} />
    <div class="article-grid">
      {!!headings.length && <TOC headings={headings} />}
      <div class="article-content prose"><slot />
        {data.sources.length > 0 && <section class="sources-box"><h2>المصادر والمراجع</h2><ol>{data.sources.map((s) => <li><a href={s.url} rel="nofollow noreferrer" target="_blank">{s.title}</a></li>)}</ol></section>}
        <section class="correction-box"><h2>وجدت معلومة تحتاج تحديثًا؟</h2><p>أرسل لنا رابط الصفحة والمعلومة الصحيحة مع مصدرها، وسيتم توثيق المراجعة في سجل التصحيحات.</p><a class="button secondary" href="/contact/">إبلاغ فريق التحرير</a></section>
      </div>
    </div>
  </article>
</BaseLayout>
