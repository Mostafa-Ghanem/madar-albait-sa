---
import type { TocItem } from "@/utils/generateToc";
interface Props { heading: TocItem }
const { heading: { children, depth, slug, text } } = Astro.props;
---
<li class:list={[depth > 2 && "nested"]}>
  <a href={`#${slug}`}>{text}</a>
  {!!children.length && <ol>{children.map((subheading) => <Astro.self heading={subheading} />)}</ol>}
</li>
