---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { getAuthor } from "@/data/authors";
import { categoryMeta } from "@/site.config";
interface Props { content: CollectionEntry<"post">; readingTime: string }
const { content: { data }, readingTime } = Astro.props;
const author = getAuthor(data.authorSlug);
const reviewer = data.reviewerSlug ? getAuthor(data.reviewerSlug) : null;
const category = categoryMeta[data.category];
const statusText = data.verificationStatus === 'verified' ? 'تم التحقق من المعلومات المتغيرة' : data.verificationStatus === 'pending' ? 'بانتظار تحقق ميداني' : 'محتوى إرشادي ثابت';
---
<div class="article-masthead">
  <nav class="breadcrumb" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>←</span><a href={`/categories/${data.category}/`}>{category?.title}</a></nav>
  <div class="article-labels"><span class="category-pill">{category?.icon} {category?.title}</span><span class:list={["verification-badge", data.verificationStatus]}>{statusText}</span></div>
  <h1>{data.title}</h1>
  <p class="article-deck">{data.description}</p>
  <div class="byline-grid">
    <div class="author-mini"><span>{author.initials}</span><div><strong>{author.name}</strong><small>{author.role}</small></div></div>
    {reviewer && <div class="author-mini"><span>{reviewer.initials}</span><div><strong>راجعه {reviewer.name}</strong><small>{reviewer.role}</small></div></div>}
  </div>
  <div class="article-dates">
    <span>نُشر <FormattedDate date={data.publishDate} /></span>
    {data.updatedDate && <span>حُدث <FormattedDate date={data.updatedDate} /></span>}
    {data.lastVerifiedDate && <span>آخر تحقق <FormattedDate date={data.lastVerifiedDate} /></span>}
    <span>{readingTime}</span>
  </div>
  {data.affiliate && <div class="disclosure-mini">قد يتضمن هذا الدليل روابط أفلييت، ولا يؤثر ذلك على سعر الشراء أو ترتيب توصياتنا.</div>}
</div>
