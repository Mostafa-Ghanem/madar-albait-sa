---
import type { CollectionEntry } from "astro:content";
import { categoryMeta } from "@/site.config";
import FormattedDate from "@/components/FormattedDate.astro";
interface Props { post: CollectionEntry<"post">; compact?: boolean }
const { post, compact = false } = Astro.props;
const category = categoryMeta[post.data.category];
---
<article class:list={["post-card", compact && "compact"]}>
  <div class="post-card-top"><span class="category-pill">{category?.icon} {category?.title}</span>{post.data.verificationStatus === "verified" && <span class="verified-pill">✓ تم التحقق</span>}</div>
  <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
  {!compact && <p>{post.data.description}</p>}
  <div class="post-meta"><FormattedDate date={post.data.updatedDate ?? post.data.publishDate} /><span>قراءة عملية</span></div>
</article>
