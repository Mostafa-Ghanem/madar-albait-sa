---
import type { PaginationLink } from "@/types";
interface Props { nextUrl?: PaginationLink; prevUrl?: PaginationLink }
const { nextUrl, prevUrl } = Astro.props;
---
{(prevUrl || nextUrl) && <nav class="pagination" aria-label="التنقل بين الصفحات">
  {prevUrl && <a href={prevUrl.url}>{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}{prevUrl.text || "→ الصفحة السابقة"}</a>}
  {nextUrl && <a href={nextUrl.url}>{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}{nextUrl.text || "الصفحة التالية ←"}</a>}
</nav>}
